{%- from "_macros.svg.j2" import widget_title -%}
<svg xmlns="http://www.w3.org/2000/svg"
     width="{{ w }}" height="{{ h }}">
{%- if has_rows -%}
{{ widget_title(title, title_font_sz, fill=hex_gray) }}

{#-  Hero: "NEXT APPOINTMENT" heading, big bold time, event title. -#}
<text
  x="{{ lpad }}" y="{{ hero_heading_y }}"
  font-family="Roboto"
  font-size="{{ group_heading_sz }}"
  font-weight="bold"
  dominant-baseline="hanging"
  fill="{{ hex_gray }}">{{ hero_heading }}</text>
{%- if hero_time %}
<text
  x="{{ lpad }}" y="{{ hero_time_y }}"
  font-family="Roboto"
  font-size="{{ hero_time_sz }}"
  font-weight="bold"
  dominant-baseline="hanging"
  fill="{{ hex_black }}">{{ hero_time }}</text>
{%- endif %}
<text
  x="{{ lpad }}" y="{{ hero_summary_y }}"
  font-family="Roboto"
  font-size="{{ hero_summary_sz }}"
  dominant-baseline="hanging"
  fill="{{ hex_black }}">{{ hero_summary }}</text>

{#-  Grouped remaining events. -#}
{%- for group in groups %}
{%- if not loop.first %}
<line
  x1="{{ lpad }}"
  y1="{{ group.heading_y - 6 }}"
  x2="{{ w - lpad }}"
  y2="{{ group.heading_y - 6 }}"
  stroke="{{ hex_light_gray }}"
  stroke-width="{{ divider_stroke_w }}"/>
{%- endif %}
<text
  x="{{ lpad }}" y="{{ group.heading_y }}"
  font-family="Roboto"
  font-size="{{ group_heading_sz }}"
  font-weight="bold"
  dominant-baseline="hanging"
  fill="{{ hex_gray }}">{{ group.heading }}</text>
{%- for row in group.rows %}
{%- if row.time %}
<text
  x="{{ lpad }}" y="{{ row.y }}"
  font-family="Roboto"
  font-size="{{ event_row_sz }}"
  font-weight="bold"
  dominant-baseline="hanging"
  fill="{{ hex_black }}">{{ row.time }}</text>
{%- endif %}
<text
  x="{{ lpad + time_col_w }}" y="{{ row.y }}"
  font-family="Roboto"
  font-size="{{ event_row_sz }}"
  dominant-baseline="hanging"
  fill="{{ hex_black }}">{{ row.summary }}</text>
{%- endfor %}
{%- endfor %}
{%- endif -%}
</svg>

